{
  "name": "thangs-api-examples",
  "private": true,
  "description": "Documentation and example code for the Thangs API",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "workspaces": [
    "samples/*"
  ],
  "scripts": {
