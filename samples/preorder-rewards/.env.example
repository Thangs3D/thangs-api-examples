# Your Thangs API key. It needs Delegated auth access.
THANGS_API_KEY=

# The Thangs API host. Defaults to https://production-api.thangs.com.
THANGS_API_HOST=https://production-api.thangs.com

# The ID of the preorder reward that unlocks the feature.
REWARD_ID=

# The ID of the reward's feature item that this app provides.
FEATURE_ITEM_ID=

# The port the sample listens on.
PORT=3000
